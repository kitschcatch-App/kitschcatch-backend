# Spring profile
SPRING_PROFILES_ACTIVE=local

# Local database
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/kitschcatch_local
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=postgres

# Dev database
DEV_DB_URL=jdbc:postgresql://dev-host:5432/kitschcatch_dev
DEV_DB_USERNAME=dev_user
DEV_DB_PASSWORD=dev_password

# Prod database
PROD_DB_URL=jdbc:postgresql://prod-host:5432/kitschcatch_prod
PROD_DB_USERNAME=prod_user
PROD_DB_PASSWORD=prod_password

# Private S3 product/profile images (inject through the runtime environment)
APP_S3_REGION=ap-northeast-2
APP_S3_BUCKET=
APP_S3_DOWNLOAD_URL_TTL=15m
